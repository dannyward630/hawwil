{
  "name": "Hawwil | حوّل",
  "short_name": "Hawwil",
  "description": "Convert and compress any file, free and private, in your browser. حوّل واضغط أي ملف مجاناً وبخصوصية كاملة.",
  "start_url": "index.html",
  "scope": "./",
  "display": "standalone",
  "background_color": "#0b0f1a",
  "theme_color": "#0b0f1a",
  "lang": "ar",
  "dir": "rtl",
  "categories": ["utilities", "productivity"],
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "favicon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "share_target": {
    "action": "share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "files",
          "accept": ["application/pdf", "image/*", "video/*", "audio/*", ".docx", ".heic", ".heif", ".txt", ".md", ".csv", ".json", ".html"]
        }
      ]
    }
  },
  "file_handlers": [
    {
      "action": "share.html",
      "accept": {
        "application/pdf": [".pdf"],
        "image/*": [".jpg", ".jpeg", ".png", ".webp", ".gif", ".bmp", ".avif", ".heic", ".heif"],
        "video/*": [".mp4", ".mov", ".webm", ".mkv", ".m4v"],
        "audio/*": [".mp3", ".wav", ".m4a", ".ogg", ".flac"],
        "application/vnd.openxmlformats-officedocument.wordprocessingml.document": [".docx"]
      }
    }
  ],
  "shortcuts": [
    { "name": "Merge PDF | دمج PDF", "url": "merge-pdf.html", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Compress Images | ضغط الصور", "url": "compress-image.html", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "HEIC to JPG | تحويل HEIC", "url": "heic-to-jpg.html", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Video to Audio | فيديو إلى صوت", "url": "video-to-audio.html", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
